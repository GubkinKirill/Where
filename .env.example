# Copy to .env and adjust. Never commit .env.

# Base address of the app, used to build QR links. Must be reachable from phones.
BASE_URL=http://192.168.1.10:8000

# SQLite database file
DB_PATH=data/inventory.db

# Directory for uploaded photos
PHOTO_DIR=data/photos

# Session cookie signing key. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-before-deploying

# Session lifetime, seconds (default 12 hours)
SESSION_MAX_AGE=43200
